{
  "name": "todo-watch",
  "version": "1.0.0",
  "description": "Watch GitHub issues and PRs linked in TODO comments",
  "keywords": [
    "cli",
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "github",
    "issues",
    "oxlint",
    "oxlint-plugin",
    "pull-requests",
    "todo"
  ],
  "license": "MIT",
  "author": "Chris Cook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zirkelc/todo-watch.git"
  },
  "bin": {
    "todo-watch": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./eslint": "./dist/eslint.mjs",
    "./oxlint": "./dist/oxlint.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "test": "vitest",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "format": "oxfmt --write",
    "format:ci": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.85.0",
    "synckit": "^0.11.13"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^25.9.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^0.23.0",
    "pkg-pr-new": "^0.0.75",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "pnpm lint",
      "pnpm format"
    ],
    "*.{json,jsonc}": [
      "pnpm format"
    ]
  },
  "packageManager": "pnpm@10.29.2"
}
